{
    "name": "manasija/drishti-sdk",
    "description": "PHP client for the Drishti API (/v1): Indian stock market news, filings, earnings, concalls and real-time WebSocket feeds",
    "type": "library",
    "license": "MIT",
    "keywords": ["drishti-api", "sdk", "php", "http-client", "websocket", "indian-stock-market"],
    "homepage": "https://drishti.manasija.in",
    "authors": [
        { "name": "Manasija" }
    ],
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.8 || ^8.0",
        "guzzlehttp/psr7": "^2.6 || ^3.1",
        "phrity/websocket": "^3.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^2.0 || ^3.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Drishti\\": "php/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Drishti\\Tests\\": "php/tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit -c php/phpunit.xml.dist",
        "analyse": "phpstan analyse -c php/phpstan.neon.dist"
    },
    "archive": {
        "exclude": [
            "/python",
            "/js",
            "/mcp",
            "/skills",
            "/conformance",
            "/.github",
            "/php/tests",
            "/php/phpunit.xml.dist",
            "/php/phpstan.neon.dist"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
