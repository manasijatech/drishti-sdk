{
  "name": "drishti-sdk",
  "version": "1.0.0",
  "description": "TypeScript/JavaScript client for the Drishti API (/v1)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "keywords": [
    "drishti-api",
    "sdk",
    "typescript",
    "javascript",
    "http-client"
  ],
  "author": "Manasija",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "ws:listen-all": "node scripts/ws-listen-all.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "~5.6.0",
    "ws": "^8.21.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manasijatech/drishti-sdk.git"
  }
}
